// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Enquiry {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String
  service      String
  destination  String
  message      String
  status       String   @default("new")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model EligibilityCheck {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  goal        String
  destination String
  timeline    String
  refusals    String
  readiness   String
  status      String   @default("new")
  createdAt   DateTime @default(now())
}
